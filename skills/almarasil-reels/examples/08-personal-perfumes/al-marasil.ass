Dialogue: 0,0:00:00.65,0:00:01.57,Main,,0,0,0,,منافسك ممكن
Dialogue: 0,0:00:01.57,0:00:02.91,Main,,0,0,0,,{\c&H00E6742E}يقلّد{\c&H00FFFFFF} فكرة منتجك
Dialogue: 0,0:00:03.18,0:00:04.04,Main,,0,0,0,,لون المنتج
Dialogue: 0,0:00:04.04,0:00:05.64,Main,,0,0,0,,أو حتى الشكل والملصق
Dialogue: 0,0:00:06.06,0:00:07.54,Main,,0,0,0,,لكن عطر منتجك
Dialogue: 0,0:00:07.54,0:00:09.12,Main,,0,0,0,,هو الهوية المميزة إله
Dialogue: 0,0:00:09.28,0:00:11.02,Main,,0,0,0,,والي ترتبط {\c&H00E6742E}بذاكرة{\c&H00FFFFFF} الزبون
Dialogue: 0,0:00:11.02,0:00:12.48,Main,,0,0,0,,حتى لو نسى شكل المنتج
Dialogue: 0,0:00:12.90,0:00:14.38,Main,,0,0,0,,والحل وفرناه إلك
Dialogue: 0,0:00:14.75,0:00:16.21,Main,,0,0,0,,زيوت عطرية صناعية
Dialogue: 0,0:00:16.21,0:00:18.27,Main,,0,0,0,,مخصصة للمنظفات والكوزمتك
Dialogue: 0,0:00:18.54,0:00:19.64,Main,,0,0,0,,تختار منها {\c&H00E6742E}الرائحة{\c&H00FFFFFF}
Dialogue: 0,0:00:19.64,0:00:20.68,Main,,0,0,0,,اللي {\c&H00E6742E}تميّز{\c&H00FFFFFF} منتجك
Dialogue: 0,0:00:20.84,0:00:22.70,Main,,0,0,0,,وتربط المستخدم بالمنتج
Dialogue: 0,0:00:23.12,0:00:25.48,Main,,0,0,0,,عطور مستوحاة من براندات عالمية
Dialogue: 0,0:00:25.64,0:00:27.46,Main,,0,0,0,,بطوابع مميزة تخلّيك
Dialogue: 0,0:00:27.46,0:00:28.98,Main,,0,0,0,,تختار العطر المناسب
Dialogue: 0,0:00:29.14,0:00:30.54,Main,,0,0,0,,حسب هوية منتجك
Dialogue: 0,0:00:30.96,0:00:31.98,Main,,0,0,0,,ويا المراسيل
Dialogue: 0,0:00:31.98,0:00:34.18,Main,,0,0,0,,خَلِّ لمنتجك هويّة تشمها العين
